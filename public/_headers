/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Content-Security-Policy is set dynamically per-request in entry.server.tsx
  # so script-src can carry a nonce (required for React Router's inline
  # hydration scripts). A static CSP here would combine restrictively with
  # that one and block the nonce'd scripts again.
